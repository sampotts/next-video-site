MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Optional. Fetch the next-video README through the authenticated GitHub API
# instead of the anonymous raw endpoint (which is rate limited per IP).
GITHUB_TOKEN=

# Optional. Error reporting. The Sentry integration on the Vercel Marketplace
# sets these automatically; locally you can leave them blank to disable Sentry.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
